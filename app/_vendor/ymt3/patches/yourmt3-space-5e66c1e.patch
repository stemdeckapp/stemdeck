-def get_checksum(file_path: os.PathLike, buffer_size: int = 65536) -> str:
-    md5 = hashlib.md5()
-    with open(file_path, "rb") as f:
-        while True:
-            data = f.read(buffer_size)
-            if not data:
-                break
-            md5.update(data)
-    return md5.hexdigest()
