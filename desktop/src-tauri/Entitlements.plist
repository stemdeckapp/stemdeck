<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Applied only when the app is code-signed (bundle.macOS.entitlements in
  tauri.conf.json). Release builds are not signed today, so this changes
  nothing yet. Under the hardened runtime that notarization requires, the
  microphone and the camera are refused without these two keys, even after
  the user allows them; they are here so that signing later does not quietly
  break recording.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <key>com.apple.security.device.camera</key>
  <true/>
</dict>
</plist>
