<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Applied when scripts/macos/make-app.sh signs the app with the hardened
  runtime that notarization requires (Tauri itself does not sign it; see
  #857). Under the hardened runtime the microphone and the camera are refused
  without these two keys, even after the user allows them. Nothing else is
  needed: Python and ffmpeg run as separate child processes, which the
  parent's hardened runtime does not restrict, and no third-party library is
  loaded into the stemdeck process itself.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <key>com.apple.security.device.camera</key>
  <true/>
</dict>
</plist>
